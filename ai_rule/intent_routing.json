{
  "version": "2.0",
  "description": "SwiftBoot 智能问答意图路由引擎配置。结合语义向量(Semantic)与正则规则(Regex)的双重识别。",
  "settings": {
    "similarity_threshold": 0.70,
    "fallback_to_rules": true,
    "default_intent": "CHAT"
  },
  "intents": [
    {
      "id": "CODE",
      "name": "源码分析与排错意图",
      "priority": 100,
      "description": "当用户要求你阅读代码、解释某段代码的实现、排查代码报错、分析系统异常堆栈、查询数据库表结构或字段含义、以及查找具体的类名或方法名时，触发此意图。这个意图专注于底层的技术实现细节。",
      "match_rules": {
        "positive_regex": [
          "(代码|源码|底层)是?怎么(实现|写|跑)的",
          "(帮我|请)?(看看|分析|排查)这个?(报错|异常|bug|问题)",
          "(接口|api|controller|service|mapper)的?(定义|逻辑|实现)",
          "数据库(表|字段|结构)",
          "类.*方法",
          "NullPointerException|Exception|Error"
        ],
        "positive_keywords": [
          "代码", "实现", "报错", "异常", "bug", "接口", "api", "controller", "service", 
          "mapper", "sql", "数据库", "字段", "类", "方法", "函数", "编译", "依赖", "源码"
        ],
        "negative_keywords": [
          "怎么配置", "宏观架构", "文档在哪"
        ]
      }
    },
    {
      "id": "DOC",
      "name": "业务文档与架构意图",
      "priority": 90,
      "description": "当用户询问系统的整体架构设计、某个业务模块的宏观流转流程、系统某个功能在业务上是怎么用的、如何进行环境配置，或者需要阅读系统的开发指南和说明手册时，触发此意图。这个意图专注于高层的业务设计和使用说明。",
      "match_rules": {
        "positive_regex": [
          "业务(流程|逻辑|线)是?怎么(走|运转|设计)的",
          "(整体|系统)(架构|设计)",
          "(功能|模块)怎么(用|使用)",
          "(怎么|如何)(配置|部署|启动)"
        ],
        "positive_keywords": [
          "怎么用", "如何使用", "业务流程", "架构", "文档", "说明", "介绍", 
          "整体", "结构", "指南", "手册", "配置", "部署"
        ],
        "negative_keywords": [
          "哪行代码", "这个类", "具体实现"
        ]
      }
    },
    {
      "id": "MEMORY",
      "name": "历史记忆追问意图",
      "priority": 80,
      "description": "当用户在对话中引用之前的上下文，要求你回忆刚才说过的话、继续上一轮未完成的讨论、或者提到“之前”、“上次”等表示时间连贯性的词汇时，触发此意图。",
      "match_rules": {
        "positive_regex": [
          "继续(刚才|之前|上面)的?(话题|内容)",
          "你(刚刚|刚才|之前|上次)说",
          "结合(之前|上面)的?(上下文|记录|代码)"
        ],
        "positive_keywords": [
          "刚才", "上次", "之前", "继续", "前面", "我们聊过", "你说过", "历史", "上下文", "那个"
        ],
        "negative_keywords": []
      }
    },
    {
      "id": "CHAT",
      "name": "日常闲聊意图",
      "priority": 10,
      "description": "用户进行日常的问候、感谢、夸奖、道别，或者提出与编程、项目无关的通用开放性问题。",
      "match_rules": {
        "positive_regex": [
          "^(你好|hello|hi|在吗)[!！~。]*$",
          "^(谢谢|感谢|太棒了|可以的)[!！~。]*$",
          "你是谁",
          "你能干什么"
        ],
        "positive_keywords": [
          "你好", "谢谢", "你是谁", "哈哈", "再见", "不错", "可以"
        ],
        "negative_keywords": [
          "代码", "项目", "报错"
        ]
      }
    }
  ]
}